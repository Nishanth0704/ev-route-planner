# ==============================================================================
# EV Route & Charging Planner - Environment Configuration
# ==============================================================================

# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Map & Routing APIs (Leaflet + OpenStreetMap + OSRM + Photon)
# Default endpoints are free and open; you can override with your own servers or providers
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
VITE_GEOCODING_API_URL=https://photon.komoot.io/api/

# Optional: Mapbox / Custom Map Provider API Key
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAP_API_KEY=
